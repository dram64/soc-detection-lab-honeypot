{
  "rule_id": "365b73e5-7b21-43a9-ae6b-d69deab771a6",
  "name": "[Sigma] Crypto-Miner Payload Uploaded to Honeypot (RedTail)",
  "description": "An attacker uploaded (SCP/SFTP) files matching the RedTail cryptominer\nkit: per-architecture 'redtail.*' binaries plus the 'setup.sh' / 'clean.sh'\ninstaller scripts. The honeypot records the SHA-256; per ADR-009 the binaries\nthemselves are not retained in this repo or in Elasticsearch.",
  "type": "esql",
  "language": "esql",
  "query": "from cowrie-* metadata _id, _index, _version | where event.action==\"cowrie.session.file_upload\" and (starts_with(file.name, \"redtail.\") or file.name in (\"setup.sh\", \"clean.sh\"))",
  "severity": "high",
  "risk_score": 73,
  "from": "now-139d",
  "to": "now",
  "interval": "24h",
  "enabled": false,
  "max_signals": 2000,
