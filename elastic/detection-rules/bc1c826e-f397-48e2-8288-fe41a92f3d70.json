{
  "rule_id": "bc1c826e-f397-48e2-8288-fe41a92f3d70",
  "name": "[Sigma] SSH Authorized Keys Implant via Shell Command",
  "description": "A command that writes an SSH public key into authorized_keys, giving the\nattacker key-based re-entry that survives a password change. In this dataset\nthe pattern usually comes with 'chattr -ia .ssh' (strip immutable/append-only\nattributes) and 'rm -rf .ssh' (wipe competing keys).",
  "type": "esql",
  "language": "esql",
  "query": "from cowrie-* metadata _id, _index, _version | where event.action==\"cowrie.command.input\" and process.command_line like \"*authorized_keys*\" and process.command_line like \"*ssh-rsa*\"",
  "severity": "high",
  "risk_score": 73,
  "from": "now-139d",
  "to": "now",
  "interval": "24h",
  "enabled": false,
  "max_signals": 2000,
